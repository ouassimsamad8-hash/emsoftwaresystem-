{
  "kind": "collectionType",
  "collectionName": "authors",
  "info": {
    "singularName": "author",
    "pluralName": "authors",
    "displayName": "Author",
    "description": "Authors and contributors"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "role": {
      "type": "string",
      "maxLength": 100
    },
    "bio": {
      "type": "text",
      "maxLength": 300
    },
    "fullBio": {
      "type": "richtext"
    },
    "email": {
      "type": "email"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "expertise": {
      "type": "json",
      "description": "Array of expertise tags"
    },
    "social": {
      "type": "json",
      "description": "Social media links (linkedin, twitter, github, website)"
    },
    "joinedDate": {
      "type": "date"
    },
    "totalViews": {
      "type": "integer",
      "default": 0
    },
    "blog_posts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-post.blog-post",
      "mappedBy": "author"
    }
  }
}
