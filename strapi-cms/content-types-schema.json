{
  "service": {
    "kind": "collectionType",
    "collectionName": "services",
    "info": {
      "singularName": "service",
      "pluralName": "services",
      "displayName": "Service"
    },
    "options": {
      "draftAndPublish": true
    },
    "attributes": {
      "title_en": {
        "type": "string",
        "required": true
      },
      "title_fr": {
        "type": "string",
        "required": true
      },
      "slug": {
        "type": "uid",
        "targetField": "title_en",
        "required": true
      },
      "icon": {
        "type": "string",
        "required": true
      },
      "shortDescription_en": {
        "type": "text",
        "required": true
      },
      "shortDescription_fr": {
        "type": "text",
        "required": true
      },
      "fullDescription_en": {
        "type": "richtext",
        "required": true
      },
      "fullDescription_fr": {
        "type": "richtext",
        "required": true
      },
      "features_en": {
        "type": "json"
      },
      "features_fr": {
        "type": "json"
      },
      "benefits_en": {
        "type": "json"
      },
      "benefits_fr": {
        "type": "json"
      }
    }
  },
  "project": {
    "kind": "collectionType",
    "collectionName": "projects",
    "info": {
      "singularName": "project",
      "pluralName": "projects",
      "displayName": "Project"
    },
    "options": {
      "draftAndPublish": true
    },
    "attributes": {
      "title_en": {
        "type": "string",
        "required": true
      },
      "title_fr": {
        "type": "string",
        "required": true
      },
      "slug": {
        "type": "uid",
        "targetField": "title_en",
        "required": true
      },
      "category": {
        "type": "enumeration",
        "enum": ["web", "mobile", "custom", "cloud"],
        "required": true
      },
      "categoryLabel_en": {
        "type": "string",
        "required": true
      },
      "categoryLabel_fr": {
        "type": "string",
        "required": true
      },
      "description_en": {
        "type": "text",
        "required": true
      },
      "description_fr": {
        "type": "text",
        "required": true
      },
      "image": {
        "type": "media",
        "multiple": false,
        "required": false,
        "allowedTypes": ["images"]
      },
      "technologies": {
        "type": "json"
      },
      "challenge_en": {
        "type": "text"
      },
      "challenge_fr": {
        "type": "text"
      },
      "solution_en": {
        "type": "text"
      },
      "solution_fr": {
        "type": "text"
      },
      "results_en": {
        "type": "json"
      },
      "results_fr": {
        "type": "json"
      },
      "screenshots": {
        "type": "media",
        "multiple": true,
        "required": false,
        "allowedTypes": ["images"]
      }
    }
  },
  "blog-post": {
    "kind": "collectionType",
    "collectionName": "blog_posts",
    "info": {
      "singularName": "blog-post",
      "pluralName": "blog-posts",
      "displayName": "Blog Post"
    },
    "options": {
      "draftAndPublish": true
    },
    "attributes": {
      "title_en": {
        "type": "string",
        "required": true
      },
      "title_fr": {
        "type": "string",
        "required": true
      },
      "slug": {
        "type": "uid",
        "targetField": "title_en",
        "required": true
      },
      "excerpt_en": {
        "type": "text",
        "required": true
      },
      "excerpt_fr": {
        "type": "text",
        "required": true
      },
      "content_en": {
        "type": "richtext",
        "required": true
      },
      "content_fr": {
        "type": "richtext",
        "required": true
      },
      "category": {
        "type": "string"
      },
      "categoryLabel_en": {
        "type": "string"
      },
      "categoryLabel_fr": {
        "type": "string"
      },
      "image": {
        "type": "media",
        "multiple": false,
        "required": false,
        "allowedTypes": ["images"]
      },
      "author": {
        "type": "string"
      },
      "publishedAt": {
        "type": "datetime"
      },
      "readTime": {
        "type": "integer"
      }
    }
  },
  "faq": {
    "kind": "collectionType",
    "collectionName": "faqs",
    "info": {
      "singularName": "faq",
      "pluralName": "faqs",
      "displayName": "FAQ"
    },
    "options": {
      "draftAndPublish": true
    },
    "attributes": {
      "question_en": {
        "type": "text",
        "required": true
      },
      "question_fr": {
        "type": "text",
        "required": true
      },
      "answer_en": {
        "type": "richtext",
        "required": true
      },
      "answer_fr": {
        "type": "richtext",
        "required": true
      },
      "category": {
        "type": "string"
