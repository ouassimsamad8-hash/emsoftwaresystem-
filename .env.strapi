# Strapi Configuration
VITE_STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=

# Add your Strapi API token here after creating it in Strapi admin panel
# Settings > API Tokens > Create new API Token
# Token type: Read-Only (for frontend) or Full Access (for migration script)

# Google Translate API (OPTIONAL - works without it for basic usage)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key-here
